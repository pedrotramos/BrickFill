{
  "name": "brickfill",
  "version": "0.1.0",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development node --env-file-if-exists=./.env --import tsx ./server/server.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "clean": "rm -rf client/dist dist build node_modules",
    "prebuild": "npm run sync",
    "predev": "npm run sync",
    "sync": "appkit plugin sync --write --silent",
    "setup": "appkit setup --write",
    "icons": "node scripts/generate-icons.mjs"
  },
  "keywords": [],
  "author": "BrickFill contributors",
  "license": "Apache-2.0",
  "description": "BrickFill: evidence-first catalog enrichment with AI, verifiable sources and human review, on Databricks",
  "dependencies": {
    "@databricks/appkit": "0.38.1",
    "@databricks/appkit-ui": "0.38.1",
    "@databricks/sdk-experimental": "0.17.0",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "0.546.0",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "3.0.6",
    "react-router": "7.13.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.37.0",
    "@eslint/compat": "2.0.0",
    "@eslint/js": "9.39.1",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "4.1.17",
    "@types/express": "5.0.5",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "prettier": "3.6.2",
    "sharp": "0.34.5",
    "tailwindcss": "4.0.14",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "4.0.14"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
