  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one filled action per area; darkens on hover.",
      "html": "<button class=\"ds-btn-primary\">Open review queue</button>",
      "css": ".ds-btn-primary{font-family:ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;gap:8px;height:32px;padding:6px 12px;border:0;border-radius:6px;background:var(--primary,#2272b4);color:var(--primary-foreground,#fff);font-size:14px;font-weight:500;cursor:pointer;transition:background-color .15s}.ds-btn-primary:hover{background:var(--primary-hover,#0e538b)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,#2272b4) 50%,transparent)}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary actions; blue wash on hover.",
      "html": "<button class=\"ds-btn-outline\">Clear filters</button>",
      "css": ".ds-btn-outline{font-family:ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;gap:8px;height:32px;padding:6px 12px;border:1px solid var(--border,#d1d9e1);border-radius:6px;background:var(--background,#fff);color:var(--foreground,#11171c);font-size:14px;font-weight:500;cursor:pointer;transition:background-color .15s,color .15s}.ds-btn-outline:hover{background:var(--accent,#edf3f9);color:var(--accent-foreground,#0e538b)}.ds-btn-outline:focus-visible{outline:none;border-color:var(--ring,#2272b4);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,#2272b4) 50%,transparent)}"
    },
    {
      "name": "Refresh Button",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "The one refresh control on every page title row.",
      "html": "<button class=\"ds-btn-refresh\" aria-label=\"Refresh\" title=\"Refresh\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8\"/><path d=\"M21 3v5h-5\"/><path d=\"M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16\"/><path d=\"M8 16H3v5\"/></svg></button>",
      "css": ".ds-btn-refresh{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;padding:0;border:1px solid var(--border,#d1d9e1);border-radius:6px;background:var(--background,#fff);color:var(--foreground,#11171c);cursor:pointer}.ds-btn-refresh:hover{background:var(--accent,#edf3f9);color:var(--accent-foreground,#0e538b)}.ds-btn-refresh:focus-visible{outline:none;border-color:var(--ring,#2272b4);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,#2272b4) 50%,transparent)}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input",
      "description": "32px field with a 3:1 outline and leading icon.",
      "html": "<label class=\"ds-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input class=\"ds-input\" placeholder=\"Search by name, GTIN or brand\" /></label>",
      "css": ".ds-search{position:relative;display:block;max-width:384px}.ds-search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted-foreground,#5f7281)}.ds-input{font-family:ui-sans-serif,system-ui,sans-serif;box-sizing:border-box;width:100%;height:32px;padding:4px 12px 4px 36px;border:1px solid var(--input,#7a8c9b);border-radius:6px;background:var(--background,#fff);color:var(--foreground,#11171c);font-size:14px;outline:none}.ds-input::placeholder{color:var(--muted-foreground,#5f7281)}.ds-input:focus-visible{border-color:var(--ring,#2272b4);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,#2272b4) 50%,transparent)}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "sidebar-item",
      "description": "Compact sidebar rows; current page on the blue wash.",
      "html": "<nav class=\"ds-sidebar\"><a class=\"ds-side-item is-active\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect width=\"7\" height=\"9\" x=\"3\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"14\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"9\" x=\"14\" y=\"12\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"3\" y=\"16\" rx=\"1\"/></svg>Overview</a><a class=\"ds-side-item\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect width=\"7\" height=\"9\" x=\"3\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"14\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"9\" x=\"14\" y=\"12\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"3\" y=\"16\" rx=\"1\"/></svg>Catalog</a><a class=\"ds-side-item\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect width=\"7\" height=\"9\" x=\"3\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"14\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"9\" x=\"14\" y=\"12\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"3\" y=\"16\" rx=\"1\"/></svg>Settings</a></nav>",
      "css": ".ds-sidebar{font-family:ui-sans-serif,system-ui,sans-serif;display:flex;flex-direction:column;gap:2px;width:216px;padding:16px 12px;background:var(--sidebar,#f6f7f9);border-right:1px solid var(--sidebar-border,#d1d9e1)}.ds-side-item{display:flex;align-items:center;gap:10px;height:32px;padding:0 10px;border-radius:6px;color:var(--sidebar-foreground,#11171c);font-size:14px;text-decoration:none;transition:background-color .15s}.ds-side-item:hover{background:color-mix(in oklch,var(--sidebar-accent,#e4ecf4) 60%,transparent)}.ds-side-item.is-active{background:var(--sidebar-accent,#e4ecf4);color:var(--sidebar-accent-foreground,#0e538b);font-weight:600}.ds-side-item:focus-visible{outline:none;box-shadow:0 0 0 2px var(--ring,#2272b4)}"
    },
